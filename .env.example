# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
#   cp .env.example .env.local
#
# `.env.local` is gitignored. NEVER commit real keys.
#
# IMPORTANT: none of these may start with `VITE_`.
# Vite inlines any `VITE_*` variable into the browser bundle, so a variable
# named VITE_OPENAI_API_KEY would be published to every visitor of the site.
# These are read only inside the serverless functions in `api/`.
# ---------------------------------------------------------------------------

# --- Chat assistant (api/chat.js) ------------------------------------------

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Which model answers visitors. Kept as a variable so it can be changed in the
# Vercel dashboard without a code change (a redeploy is still required).
#
# Verify the current id at https://platform.openai.com/docs/models before
# changing — OpenAI's lineup moves fast (4o -> 4.1 -> 5.x). Prefer the "mini"
# tier over "nano": nano's quality drop shows up exactly where this bot is
# least tolerant, i.e. persuasive copy and non-English replies.
OPENAI_MODEL=gpt-5.4-mini

# Optional. Comma-separated list of origins allowed to call the API.
# Leave empty during local development — the check is skipped when unset.
# Note this is only a speed bump: `Origin` is absent from curl and spoofable.
# Example: https://roshalink.com,https://www.roshalink.com
ALLOWED_ORIGINS=

# --- Lead delivery (api/lead.js) -------------------------------------------

# https://resend.com/api-keys
RESEND_API_KEY=

# Where lead notification emails are delivered.
LEAD_TO_EMAIL=

# Sender address. Must be on a domain verified in Resend.
# `onboarding@resend.dev` works out of the box for testing, but Resend only
# delivers from it to the email address that owns the Resend account.
LEAD_FROM_EMAIL=onboarding@resend.dev
